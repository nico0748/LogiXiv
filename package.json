    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  },
  "private": true,
